{
  "name": "@gatepass/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:edge": "node scripts/build-edge.mjs",
    "start": "node dist/index.js",
    "db:reset": "tsx src/db/reset-cli.ts",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "postgres": "3.4.9",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
